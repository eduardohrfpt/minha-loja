VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole-aqui-a-publishable-key-do-supabase

# API key do Asaas (Painel > Integrações > API) — server-side apenas (pasta /api)
ASAAS_API_KEY=cole-aqui-a-api-key-do-asaas

# "sandbox" usa https://api-sandbox.asaas.com/v3; qualquer outro valor (ex: "production")
# usa https://api.asaas.com/v3
ASAAS_ENV=sandbox

# Token secreto que você mesmo define e configura também no painel do Asaas em
# Integrações > Webhooks > Token de autenticação. Usado para validar que as chamadas
# em /api/asaas-webhook realmente vêm do Asaas.
ASAAS_WEBHOOK_TOKEN=defina-um-token-secreto-aqui

# Service role key do Supabase (Painel > Project Settings > API) — server-side apenas,
# ignora RLS. NUNCA exponha no client nem prefixe com VITE_.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key-do-supabase
