VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole-aqui-a-publishable-key-do-supabase

# Chave publicável do Stripe (client-side, pode ficar exposta)
# Dashboard do Stripe > Developers > API keys > Publishable key (formato pk_test_/pk_live_)
VITE_STRIPE_PUBLISHABLE_KEY=cole-aqui-a-publishable-key-do-stripe

# Chave secreta do Stripe (server-side apenas, pasta /api) — NUNCA prefixar com VITE_
# Dashboard do Stripe > Developers > API keys > Secret key (formato sk_test_/sk_live_)
STRIPE_SECRET_KEY=cole-aqui-a-secret-key-do-stripe

# Signing secret do endpoint de webhook do Stripe (Dashboard > Developers > Webhooks)
# (formato whsec_...)
STRIPE_WEBHOOK_SECRET=cole-aqui-o-signing-secret-do-webhook

# Service role key do Supabase (Painel > Project Settings > API) — server-side apenas,
# ignora RLS. NUNCA exponha no client nem prefixe com VITE_.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key-do-supabase
