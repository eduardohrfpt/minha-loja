VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=cole-aqui-a-publishable-key-do-supabase

# Service role key do Supabase (Painel > Project Settings > API) — server-side apenas,
# ignora RLS. NUNCA exponha no client nem prefixe com VITE_.
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key-do-supabase

# Public key do Mercado Pago (client-side, pode ficar exposta). Não é usada pelo fluxo atual
# de Checkout Pro (que redireciona via URL), mas fica documentada para uso futuro (Bricks etc).
VITE_MERCADOPAGO_PUBLIC_KEY=cole-aqui-a-public-key-do-mercado-pago

# Access token do Mercado Pago (server-side apenas, pasta /api). Prefixo TEST- = sandbox,
# APP_USR- = produção (Painel do Mercado Pago > Suas integrações > Credenciais).
MERCADOPAGO_ACCESS_TOKEN=cole-aqui-o-access-token-do-mercado-pago

# Opcional: chave secreta de assinatura do webhook (Painel > Sua aplicação > Webhooks).
# Sem ela o webhook continua seguro, pois sempre reconfirma o pagamento direto na API do
# Mercado Pago antes de liberar o código; configurar isso só adiciona uma camada extra.
MERCADOPAGO_WEBHOOK_SECRET=cole-aqui-o-secret-do-webhook-opcional

# Token do bot do Telegram (fale com @BotFather) — server-side apenas (pasta /api).
TELEGRAM_BOT_TOKEN=cole-aqui-o-token-do-bot-do-telegram

# Chat ID pra onde vão as notificações de pedido de entrega manual (o seu ID pessoal, ou de um
# grupo/canal). Descubra o seu falando com @userinfobot no Telegram.
TELEGRAM_CHAT_ID=cole-aqui-o-chat-id-do-telegram

# Token secreto que você mesmo gera e usa tanto aqui quanto no setWebhook do Telegram
# (parâmetro secret_token). Usado pra validar que as chamadas em /api/telegram-webhook
# realmente vêm do Telegram.
TELEGRAM_WEBHOOK_SECRET=defina-um-token-secreto-aqui
